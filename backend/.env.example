# PostgreSQL connection string.
# Local example:      postgresql://postgres:postgres@localhost:5432/meeting_rooms
# Render/Neon/Supabase will give you a full connection string like:
#   postgresql://user:password@host:5432/dbname
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/meeting_rooms

# Comma-separated list of origins allowed to call this API.
# For local dev with the Next.js default port:
CORS_ORIGINS=http://localhost:3000

# Working hours enforced on every booking (24h, "HH:MM")
WORK_DAY_START=09:00
WORK_DAY_END=18:00
